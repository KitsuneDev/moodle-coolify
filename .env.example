# Local Docker Compose example. Coolify generates SERVICE_PASSWORD_* values itself.
MOODLE_URL=https://learn.example.com
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_FULLNAME=Example Learning
MOODLE_SITE_SHORTNAME=Example

SERVICE_PASSWORD_64_MOODLEDB=replace-with-a-long-random-value
SERVICE_PASSWORD_64_MOODLEREDIS=replace-with-a-different-long-random-value
SERVICE_PASSWORDWITHSYMBOLS_64_MOODLEADMIN=replace-with-a-strong-admin-password
SERVICE_PASSWORD_64_MOODLEUPGRADE=replace-with-a-different-upgrade-key

MOODLE_AUTO_UPGRADE=false
MOODLE_VERSION=5.2.1
MOODLE_SERIES=502
MOODLE_SHA256=db1167f3deef899aef6d4b273d3bc901b102c5d9de2e97289492505c2ec29629
